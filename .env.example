# Copy to .env and replace every placeholder, or run `make env` to generate
# a .env with random local credentials. Never commit .env.

# Password for the local Postgres container.
POSTGRES_PASSWORD=replace-with-a-random-password

# Comma-separated API keys in the form actor:role:token.
# Roles: admin (all endpoints) or reader (read and evaluate only).
# Tokens must be at least 32 characters; generate with `openssl rand -hex 32`.
# At least one admin key is required.
API_KEYS=alice:admin:replace-with-64-random-hex-characters,checkout-app:reader:replace-with-64-random-hex-characters

# Optional settings and their defaults.
# PORT=8080
# LOG_LEVEL=info
# POSTGRES_PORT=5432
